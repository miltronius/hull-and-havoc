{
  "name": "hull-and-havoc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-based naval combat / ship-building game. Build a ship block-by-block, then sail it into battle — enough ballast turns it into a submarine.",
  "packageManager": "pnpm@10.16.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "cannon": "0.6.2",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/cannon": "^0.1.12",
    "@types/node": "^22.10.1",
    "@types/three": "0.128.0",
    "eslint": "^9.15.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
